APP_NAME="Laravel POS TFA7"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# Leave DB_DATABASE unset for database/database.sqlite.
# For MySQL: DB_CONNECTION=mysql and uncomment/change these values:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_pos_tfa7
# DB_USERNAME=root
# DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
